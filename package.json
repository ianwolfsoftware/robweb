{
  "name": "robweb",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 6980 --strictPort",
    "dev:api": "REPOSITORY=memory tsx watch server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && tsx scripts/prerender.tsx && npm run build:server",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck",
    "test": "vitest run",
    "inventory:check": "python3 scripts/verify_inventory.py",
    "shell:check": "node scripts/verify-shell.mjs",
    "preview": "vite preview",
    "start": "node build-server/server/index.js",
    "admin:invite": "tsx server/scripts/invite.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "gsap": "3.15.1",
    "helmet": "8.3.0",
    "lenis": "1.3.27",
    "mysql2": "3.24.6",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "vite": "8.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/three": "0.187.0",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.7",
    "postcss": "8.5.33",
    "puppeteer-core": "25.17.0",
    "supertest": "7.3.2",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
