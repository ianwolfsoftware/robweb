# Public web (6980) and project-only API (6981)
API_PORT=6981
PUBLIC_ORIGIN=http://localhost:6980
GO_LIVE=false

# Production must use mariadb. memory is allowed only for local development/tests.
REPOSITORY=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=robweb
DB_USER=robweb
DB_PASSWORD=

SESSION_DAYS=7
FORM_RETENTION_DAYS=90

# Disabled by default. SMTP sends only an inbox reference, never form fields.
NOTIFICATION_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FORM_NOTIFICATION_TO=

# GA4 is injected only after explicit analytics consent.
GA_MEASUREMENT_ID=G-XQNLT1H91R
VITE_GA_MEASUREMENT_ID=G-XQNLT1H91R
VITE_API_ORIGIN=

# Optional read-only fallback. The public Tools & Jigs products feed is used first.
SHOPIFY_STOREFRONT_TOKEN=

# App destinations remain empty until Ian supplies approved URLs.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_WEB_APP_URL=
