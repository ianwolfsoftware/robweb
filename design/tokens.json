{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "RC / Robweb",
    "version": "0.1.0",
    "note": "Amber is an accent, never a replacement colour for the RC logo."
  },
  "color": {
    "brand": {
      "amber": { "$value": "#f5a623", "$type": "color" }
    },
    "dark": {
      "canvas": { "$value": "#0b0d10", "$type": "color" },
      "surface": { "$value": "#14171c", "$type": "color" },
      "raised": { "$value": "#1c2026", "$type": "color" },
      "text": { "$value": "#c7ccd4", "$type": "color" },
      "heading": { "$value": "#ffffff", "$type": "color" }
    },
    "light": {
      "canvas": { "$value": "#f3f4f6", "$type": "color" },
      "surface": { "$value": "#ffffff", "$type": "color" },
      "text": { "$value": "#1c2026", "$type": "color" },
      "heading": { "$value": "#0b0d10", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#3f9b62", "$type": "color" },
      "warning": { "$value": "#b86e00", "$type": "color" },
      "danger": { "$value": "#c75050", "$type": "color" },
      "focus": { "$value": "#f5a623", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Inter, ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
      "editorial": { "$value": "Georgia, 'Times New Roman', serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "$type": "dimension" },
      "6xl": { "$value": "3.75rem", "$type": "dimension" },
      "display": { "$value": "clamp(3.5rem, 8vw, 7.5rem)", "$type": "string" }
    },
    "lineHeight": {
      "tight": { "$value": 0.92, "$type": "number" },
      "heading": { "$value": 1.05, "$type": "number" },
      "body": { "$value": 1.6, "$type": "number" }
    }
  },
  "space": {
    "0": { "$value": "0", "$type": "dimension" },
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "5": { "$value": "1.25rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "10": { "$value": "2.5rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" },
    "20": { "$value": "5rem", "$type": "dimension" },
    "24": { "$value": "6rem", "$type": "dimension" },
    "32": { "$value": "8rem", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "0.25rem", "$type": "dimension" },
    "md": { "$value": "0.5rem", "$type": "dimension" },
    "lg": { "$value": "1rem", "$type": "dimension" },
    "xl": { "$value": "1.5rem", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "lift": { "$value": "0 1rem 3rem rgb(0 0 0 / 0.22)", "$type": "shadow" },
    "float": { "$value": "0 2rem 5rem rgb(0 0 0 / 0.38)", "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px #0b0d10, 0 0 0 5px #f5a623", "$type": "shadow" }
  },
  "layout": {
    "content": { "$value": "90rem", "$type": "dimension" },
    "reading": { "$value": "42rem", "$type": "dimension" },
    "gutterMobile": { "$value": "1rem", "$type": "dimension" },
    "gutterDesktop": { "$value": "clamp(2rem, 6vw, 6rem)", "$type": "string" }
  },
  "motion": {
    "instant": { "$value": "100ms", "$type": "duration" },
    "fast": { "$value": "180ms", "$type": "duration" },
    "base": { "$value": "280ms", "$type": "duration" },
    "slow": { "$value": "480ms", "$type": "duration" }
  }
}
